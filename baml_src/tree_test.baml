function TinyTree() -> TreeClassifierState {
  TreeClassifierState { n_features: 1, classes: [-3,7], nodes: [
    TreeNode { left: 1, right: 2, feature: 0, threshold: 1.0, probabilities: [] },
    TreeNode { left: -1, right: -1, feature: -2, threshold: -2.0, probabilities: [0.5,0.5] },
    TreeNode { left: -1, right: -1, feature: -2, threshold: -2.0, probabilities: [0.0,1.0] }
  ] }
}

test "tree_float32_ties_and_extremes" {
  assert.equal(TreeRoundFloat32(1.0000000596046448),1.0)
  assert.equal(TreeRoundFloat32(1.000000059604645),1.0000001192092896)
  assert.equal(TreeRoundFloat32(1.0000001788139343),1.000000238418579)
  assert.equal(TreeRoundFloat32(-1.0000000596046448),-1.0)
  assert.equal(TreeRoundFloat32(7.006492321624085e-46),0.0)
  assert.equal(TreeRoundFloat32(-7.006492321624085e-46).signum(),-1.0)
  assert.equal(TreeRoundFloat32(1.401298464324817e-45),1.401298464324817e-45)
  assert.equal(TreeRoundFloat32(3.4028234663852886e38),3.4028234663852886e38)
  assert.equal(TreeRoundFloat32(3.4028235677973366e38),float.inf())
}

test "tree_path_and_class_tie" {
  let p = TreePredictBatch([[0.0],[1.0],[1.0000000596046448],[1.000000059604645]],TinyTree());
  assert.equal(p.labels,[-3,-3,-3,7])
  assert.equal(p.leaves,[1,1,1,2])
  assert.equal(p.paths,[[0,1],[0,1],[0,1],[0,2]])
  assert.equal(p.probs,[[0.5,0.5],[0.5,0.5],[0.5,0.5],[0.0,1.0]])
}
test "tree_reject_invalid_state" {
  let a = TinyTree();
  a.nodes[0].left = 0;
  assert.is_true(TreeStateError(a) != "")
  let b = TinyTree();
  b.nodes[0].right = 1;
  assert.is_true(TreeStateError(b) != "")
  let c = TinyTree();
  c.nodes.push(c.nodes[1]);
  assert.is_true(TreeStateError(c) != "")
  let d = TinyTree();
  d.nodes[2].probabilities = [0.5,0.6];
  assert.is_true(TreeStateError(d) != "")
}
test "tree_reject_invalid_inputs" {
  let overflow: TreeBatchResult? = TreePredictBatch([[1e40]],TinyTree()) catch_all (e) { _ => null };
  let nan: TreeBatchResult? = TreePredictBatch([[float.nan()]],TinyTree()) catch_all (e) { _ => null };
  let ragged: TreeBatchResult? = TreePredictBatch([[1.0],[1.0,2.0]],TinyTree()) catch_all (e) { _ => null };
  assert.equal(overflow,null)
  assert.equal(nan,null)
  assert.equal(ragged,null)
}

// Independent oracle generated by pinned sklearn/NumPy in the integration job.
// Not packaged into the product; only available from development test sources.
class TreeOracleCase {
  name string
  state TreeClassifierState
  rows float[][]
  expected TreeBatchResult
}
class TreeRoundCase {
  input float
  rounded float?
  negative_zero bool
}
class TreeOracle {
  trees TreeOracleCase[]
  rounding TreeRoundCase[]
}
function TreeOracleProbe() -> int {
  let oracle = baml.json.decode<TreeOracle>(baml.fs.read("tree-oracle.json"));
  for (let i = 0; i < oracle.rounding.length(); i += 1) {
    let c = oracle.rounding[i];
    let actual = TreeRoundFloat32(c.input);
    match (c.rounded) {
      let expected: float => {
        assert.equal(actual,expected)
        if (expected == 0.0) { assert.equal(actual.signum() < 0.0,c.negative_zero) }
      },
      null => { assert.is_true(actual.is_infinite()) }
    }
  }
  for (let i = 0; i < oracle.trees.length(); i += 1) {
    let c = oracle.trees[i];
    let actual = TreePredictBatch(c.rows,c.state);
    assert.equal(actual.labels,c.expected.labels)
    assert.equal(actual.leaves,c.expected.leaves)
    assert.equal(actual.paths,c.expected.paths)
    for (let j = 0; j < actual.probs.length(); j += 1) {
      for (let k = 0; k < actual.probs[j].length(); k += 1) {
        assert.is_true((actual.probs[j][k] - c.expected.probs[j][k]).abs() <= 1e-12)
      }
    }
  }
  oracle.trees.length()
}
