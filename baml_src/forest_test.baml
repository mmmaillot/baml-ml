function SplitTree(threshold: float, left: float[], right: float[]) -> TreeClassifierState {
    TreeClassifierState {
        n_features: 1,
        classes: [-3, 7],
        nodes: [
            TreeNode {
                left: 1,
                right: 2,
                feature: 0,
                threshold: threshold,
                probabilities: [],
            },
            TreeNode {
                left: -1,
                right: -1,
                feature: -2,
                threshold: -2.0,
                probabilities: left,
            },
            TreeNode {
                left: -1,
                right: -1,
                feature: -2,
                threshold: -2.0,
                probabilities: right,
            },
        ],
    }
}

function StumpTree(probabilities: float[]) -> TreeClassifierState {
    TreeClassifierState {
        n_features: 1,
        classes: [-3, 7],
        nodes: [
            TreeNode {
                left: -1,
                right: -1,
                feature: -2,
                threshold: -2.0,
                probabilities: probabilities,
            },
        ],
    }
}

function TinyForest() -> ForestClassifierState {
    ForestClassifierState {
        n_features: 1,
        classes: [-3, 7],
        trees: [
            SplitTree(1.0, [1.0, 0.0], [0.0, 1.0]),
            SplitTree(0.0, [0.0, 1.0], [0.0, 1.0]),
            StumpTree([0.5, 0.5]),
        ],
    }
}

test "forest_mean_proba_labels_leaves_and_tie" {
    let p = ForestPredictBatch(
        [
            [-1.0],
            [0.5],
            [2.0],
            [1.0000000596046448],
            [1.000000059604645],
        ],
        TinyForest(),
    );
    assert.equal(p.labels, [-3, -3, 7, -3, 7]);
    assert.equal(p.probs, [
        [0.5, 0.5],
        [0.5, 0.5],
        [0.5 / 3.0, 2.5 / 3.0],
        [0.5, 0.5],
        [0.5 / 3.0, 2.5 / 3.0],
    ]);
    assert.equal(p.leaves, [
        [1, 1, 0],
        [1, 2, 0],
        [2, 2, 0],
        [1, 2, 0],
        [2, 2, 0],
    ])
}

test "forest_leaves_only_captured_when_requested" {
    let r = ForestPredictCore([[2.0]], TinyForest(), false);
    assert.equal(r.labels, [7]);
    assert.equal(r.leaves, []);
    assert.equal(ForestPredictCore([[2.0]], TinyForest(), true).leaves, [
        [2, 2, 0],
    ])
}

test "forest_single_tree_matches_tree_core" {
    let f = ForestClassifierState {
        n_features: 1,
        classes: [-3, 7],
        trees: [SplitTree(1.0, [0.5, 0.5], [0.0, 1.0])],
    };
    let rows = [[-1.0], [1.0], [1.000000059604645]];
    let a = ForestPredictBatch(rows, f);
    let b = TreePredictBatch(rows, SplitTree(1.0, [0.5, 0.5], [0.0, 1.0]));
    assert.equal(a.labels, b.labels);
    assert.equal(a.probs, b.probs);
    assert.equal(a.leaves, [[1], [1], [2]])
}

test "forest_reject_invalid_state" {
    let f = TinyForest();
    f.trees = [];
    assert.is_true(ForestStateError(f) != "");
    let g = TinyForest();
    g.classes = [7, -3];
    assert.is_true(ForestStateError(g) != "");
    let h = TinyForest();
    h.classes = [];
    assert.is_true(ForestStateError(h) != "");
    let i = TinyForest();
    i.n_features = 0;
    assert.is_true(ForestStateError(i) != "");
    let j = TinyForest();
    j.trees[0].n_features = 2;
    assert.is_true(ForestStateError(j) != "");
    let k = TinyForest();
    k.trees[1].classes = [-3, 8];
    assert.is_true(ForestStateError(k) != "");
    let l = TinyForest();
    l.trees[0].nodes[0].left = 0;
    assert.is_true(ForestStateError(l) != "");
    let m = TinyForest();
    m.trees[2].nodes[0].probabilities = [0.5, 0.6];
    assert.is_true(ForestStateError(m) != "")
}

test "forest_reject_invalid_inputs" {
    let overflow: ForestBatchResult? = ForestPredictBatch([[1e40]], TinyForest()) catch_all (e) {
        _ => null,
    };
    let nan: ForestBatchResult? = ForestPredictBatch([[float.nan()]], TinyForest()) catch_all (e) {
        _ => null,
    };
    let ragged: ForestBatchResult? = ForestPredictBatch(
        [[1.0], [1.0, 2.0]],
        TinyForest(),
    ) catch_all (e) {
        _ => null,
    };
    let wide: ForestBatchResult? = ForestPredictBatch([[1.0, 2.0]], TinyForest()) catch_all (e) {
        _ => null,
    };
    assert.equal(overflow, null);
    assert.equal(nan, null);
    assert.equal(ragged, null);
    assert.equal(wide, null)
}

// Independent oracle generated by pinned sklearn/NumPy in the integration job.
// Forest probabilities are summed in estimator order and divided once, so the
// parity with sklearn RandomForestClassifier is bit-exact for sequential
// accumulation (the default n_jobs=1), not toleranced.
class ForestOracleCase {
    name: string,
    state: ForestClassifierState,
    rows: float[][],
    expected: ForestBatchResult,
}

class ForestOracle {
    forests: ForestOracleCase[],
}

function ForestOracleProbe() -> int {
    let oracle = baml.json.decode<ForestOracle>(baml.fs.read("forest-oracle.json"));
    for (let i = 0; i < oracle.forests.length(); i += 1) {
        let c = oracle.forests[i];
        let actual = ForestPredictBatch(c.rows, c.state);
        assert.equal(actual.labels, c.expected.labels);
        assert.equal(actual.probs, c.expected.probs);
        assert.equal(actual.leaves, c.expected.leaves)
    }
    oracle.forests.length()
}
