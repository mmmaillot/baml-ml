def med: sort | if length%2==1 then .[length/2|floor] else (.[length/2-1]+.[length/2])/2 end;
def harness: test("^user\\.(Scale(Model|Rows|Float|Predict|Fit)|D(4|32|128|512)|B(32|256|1024)|Distinct(100|1000)|Repeat100|Fit(150|1000|10000))$");
def candidate_groups: {checks:["IsFinite","CheckFiniteMatrix","CheckMatrix","IsNaN"],preprocessing:["ImputerTransform","ScalerTransform"],logits:["DotUnchecked","ParamsRowLogits","ModelRowLogits"],normalization:["SoftmaxRow","LogSumExp","Exp","Log"]};
def bounds: .+{amdahl_infinite:(if .share<1 then 1/(1-.share) else null end),amdahl_10x:(1/(1-.share*0.9))};
if length!=52 or (group_by(.workload)|any(length!=4 or ([.[].trial]|sort)!=[0,1,2,3])) or any(.profile.outcome.status!="complete" or (.profile.columns|map(.name))!=["function_name","total_time","self_time","invocation_count","error_count"] or (.profile.rows|length)==0 or (.profile.rows|any(length!=5 or .[2]<0 or .[1]<.[2] or .[4]!=0))) then error("invalid or incomplete profiles") else . end |
map(. as $t | .profile.rows as $rows | ($rows|map(select(.[0]|harness|not))) as $ml | ($ml|map(.[2])|add) as $total | ($rows|map(select(.[0]=="user.ClassificationPipelinePredictProba" or .[0]=="user.ClassificationPipelineFit")|.[1])|add) as $pipeline |
($rows|map(select(.[0]=="user.ClassificationPipelinePredictProba" or .[0]=="user.ClassificationPipelineFit")|.[3])|add) as $calls |
(if ($t.workload|startswith("fit")) then 2 elif ($t.workload|test("^d(4|32|128|512)$|^distinct1000$")) then 1010 else 110 end) as $expected |
if $pipeline<=0 or $calls!=$expected or $total>$pipeline then error("unexpected pipeline coverage or invocation count: "+$t.workload) else
{workload:$t.workload,trial:$t.trial,pipeline_ns:$pipeline,exclusive_sum_ns:$total,coverage:($total/$pipeline),functions:($ml|group_by(.[0])|map({name:.[0][0][5:],self_ns:(map(.[2])|add),inclusive_ns:(map(.[1])|add),calls:(map(.[3])|add),share:((map(.[2])|add)/$pipeline)}))} end |
. as $p | .+{groups:(candidate_groups|to_entries|map(. as $g | {name:$g.key,share:(([$p.functions[]|select(.name as $n|$g.value|index($n))|.share]|add)//0)}))}) |
group_by(.workload) | map({workload:.[0].workload,trials:length,coverage:(map(.coverage)|med),pipeline_ns:(map(.pipeline_ns)|med),functions:(map(.functions[])|group_by(.name)|map({name:.[0].name,self_ns:(map(.self_ns)|med),inclusive_ns:(map(.inclusive_ns)|med),calls:(map(.calls)|med),share:(map(.share)|med)})|sort_by(-.share)|map(bounds)),groups:(map(.groups[])|group_by(.name)|map({name:.[0].name,share:(map(.share)|med)}|bounds))})
